# Copy to .env.local for local development, and add the same names in
# Vercel -> Project -> Settings -> Environment Variables for production.

# Supabase -> Connect -> "Transaction pooler" connection string (port 6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Supabase -> Project Settings -> API: Project URL, and a Secret key (sb_secret_...).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Super admin login for /admin (you). Use a long random password.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Optional
# STORAGE_BUCKET=tenant-assets
# ROOT_DOMAIN=portfolioio.com          # gives every teacher <slug>.portfolioio.com (needs a wildcard domain on Vercel)
# PLATFORM_HOSTS=admin.portfolioio.com  # extra hosts that show the platform console
