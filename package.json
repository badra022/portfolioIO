{
  "name": "portfolioio",
  "version": "0.1.0",
  "private": true,
  "description": "Teacher marketing sites: one Next.js app, many domains, data in Supabase, live admin.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-local-assets.mjs && next dev",
    "build": "next build",
    "start": "next start",
    "validate": "node --experimental-strip-types scripts/validate.ts",
    "schema": "node --experimental-strip-types scripts/generate-schema.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db-migrate.mjs",
    "postinstall": "node --experimental-strip-types scripts/generate-schema.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "drizzle-orm": "0.45.3",
    "next": "16.3.8",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "typescript": "5.9.3"
  }
}
